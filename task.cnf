[mysqld]

### Basic Settings (виправлено конфлікти) ###
user            = mysql       # Розкоментовано як основне
# user          = root        # Закоментовано для уникнення конфлікту
pid-file        = /var/run/mysqld/mysqld.pid  # Розкоментовано
socket          = /var/run/mysqld/mysqld.sock  # Розкоментовано

port            = 3306        # Використовується стандартний порт
# port          = 443         # Закоментовано альтернативний порт

datadir         = /var/lib/mysql  # Розкоментовано стандартний шлях
# datadir       = /var/data/mysql # Закоментовано альтернатива

### Network (безпека) ###
bind-address    = 127.0.0.1   # Змінено з 0.0.0.0 для локального доступу
# bind-address  = 0.0.0.0     # Закоментовано публічний доступ
mysqlx-bind-address = 127.0.0.1

### Performance ###
key_buffer_size         = 16M
max_allowed_packet     = 64M  # Розкоментовано
thread_stack           = 256K # Розкоментовано
thread_cache_size      = 8    # Встановлено фіксоване значення замість -1
max_connections        = 50   # Оптимізовано (компроміс між 5 і 151)
table_open_cache       = 2000 # Оптимізовано (знижено з 4000)

### Storage Engines ###
myisam-recover-options = BACKUP
default-storage-engine = InnoDB

### Logging (оптимізовано) ###
log_error = /var/log/mysql/error.log

slow_query_log        = 1
slow_query_log_file   = /var/log/mysql/mysql-slow.log  # Стандартний шлях
long_query_time       = 2     # Оптимізовано з 0 секунд
log_queries_not_using_indexes = 1

### Binary Logging ###
max_binlog_size       = 100M
# binlog_expire_logs_seconds = 2592000  # 30 днів (закоментовано як приклад)